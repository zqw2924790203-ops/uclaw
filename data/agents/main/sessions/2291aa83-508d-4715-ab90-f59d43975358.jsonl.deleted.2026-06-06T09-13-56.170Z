\":\"node\",\"runtimeVersion\":\"24.14.0\",\"hostname\":\"张启旺的G15\",\"name\":\"openclaw\",\"date\":\"2026-04-01T10:38:18.452Z\",\"logLevelId\":3,\"logLevelName\":\"INFO\",\"path\":{\"fullFilePath\":\"file:///C:/Users/zhang/AppData/Local/Programs/ClawX/resources/openclaw/dist/gateway-cli-DlnlX7IW.js:7896:18\",\"fileName\":\"gateway-cli-DlnlX7IW.js\",\"fileNameWithLine\":\"gateway-cli-DlnlX7IW.js:7896\",\"fileColumn\":\"18\",\"fileLine\":\"7896\",\"filePath\":\"/C:/Users/zhang/AppData/Local/Programs/ClawX/resources/openclaw/dist/gateway-cli-DlnlX7IW.js\",\"filePathWithLine\":\"/C:/Users/zhang/AppData/Local/Programs/ClawX/resources/openclaw/dist/gateway-cli-DlnlX7IW.js:7896\"}},\"time\":\"2026-04-01T18:38:18.453+08:00\"}\r\n{\"0\":\"gateway/channels/openclaw-weixin\",\"1\":\"[compat] Host OpenClaw 2026.3.28 >= 2026.3.22, OK.\",\"_meta\":{\"runtime\":\"node\",\"runtimeVersion\":\"24.14.0\",\"hostname\":\"张启旺的G15\",\"name\":\"gateway/channels/openclaw-weixin\",\"parentNames\":[\"openclaw\"],\"date\":\"2026-04-01T10:38:20.491Z\",\"logLevelId\":3,\"logLevelName\":\"INFO\"},\"time\":\"2026-04-01T18:38:20.491+08:00\"}\r\n{\"0\":\"gateway/channels/openclaw-weixin\",\"1\":\"[runtime] setWeixinRuntime called, runtime set successfully\",\"_meta\":{\"runtime\":\"node\",\"runtimeVersion\":\"24.14.0\",\"hostname\":\"张启旺的G15\",\"name\":\"gateway/channels/openclaw-weixin\",\"parentNames\":[\"openclaw\"],\"date\":\"2026-04-01T10:38:20.492Z\",\"logLevelId\":3,\"logLevelName\":\"INFO\"},\"time\":\"2026-04-01T18:38:20.492+08:00\"}\r\n{\"0\":\"{\\\"subsystem\\\":\\\"plugins\\\"}\",\"1\":\"[plugins] openclaw-lark: loaded without install/load-path provenance; treat as untracked local code and pin trust via plugins.allow or install records (C:\\\\Users\\\\zhang\\\\.openclaw\\\\extensions\\\\feishu-openclaw-plugin\\\\index.js)\",\"_meta\":{\"runtime\":\"node\",\"runtimeVersion\":\"24.14.0\",\"hostname\":\"张启旺的G15\",\"name\":\"{\\\"subsystem\\\":\\\"plugins\\\"}\",\"parentNames\":[\"openclaw\"